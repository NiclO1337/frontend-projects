# Copy this file to .env and fill in your own key. .env is git-ignored.
# Get a free access key at https://web3forms.com (enter the email address
# the contact form messages should go to).
# The key is public by design (it ends up in the browser), but keep it out of the repo.
# Vite only exposes variables that start with VITE_.
VITE_WEB3FORMS_KEY=your-access-key-here
